# Firebase Web SDK config (Firebase Console > プロジェクトの設定 > 全般 > マイアプリ)
# コピーして .env.local を作成し、実際の値を入力してください。.env.local は git 管理対象外です。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 開発時のみ: "true" にすると `firebase emulators:start` で起動したローカルの
# Auth/Firestore エミュレータに接続します（本番ビルドでは無効化されます）。
VITE_USE_FIREBASE_EMULATOR=false
